<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<connectionStrings>
    <add name="STG_AQMSConnString" connectionString="Data Source=ISTAZUA02;Initial Catalog=AQMSCentral_PROD;Persist Security Info=True; User ID=AQMSUSER;Password=$AQMSUSER$;MultipleActiveResultSets=true;" providerName="System.Data.SqlClient" />
	<add name="DEV_AQMSConnString" connectionString="data source=192.168.20.105,1439;initial catalog=AQMSADPHCINDOOR; User Id=  aqms;  Password= Ist@1234;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
    <add name="PROD_AQMSConnString" connectionString="Data Source = sql-pd-iaq.privatelink.database.windows.net,1433; Initial Catalog = iaq-db-prod; User Id=svc_iqa_app;  Password=Doh@pp@12345!;MultipleActiveResultSets=true;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<!-- Log path -->
		<add key="LogfilePath" value="C:\AQMSLogs\AQMSServerAvgLogs"/>
		<add key="Interval" value="60000"></add>
		<add key="parameterTableName" value="DMN_Parameters"></add>
		<add key="AverageTableName" value="ParameterAverages"></add>
		<add key="AverageTableNameMonth" value="ParameterAveragesMonth"></add>
		<add key="AverageTableNameYear" value="ParameterAveragesYear"></add>
		<add key="ReadingTableName" value="ParameterReadings"></add>
		<add key="FlagTableName" value="DMN_Flags"></add>
		<add key="LogTableName" value="LogTable"></add>
    <add key="envConString" value="STG_AQMSConnString"/>
	<add key="winddirection" value="WD,Wind Direction" />
	<add key="rain" value="RAIN" />
		<add key="test" value="RAIN" />
	</appSettings>
	
</configuration>