<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<connectionStrings>
  <add name="DEV_AQMSConnString"
       connectionString="Host=localhost;Port=5432;Database=aqms_dev;Username=manjith;Password=manjith"
       providerName="Npgsql" />

  <add name="PROD_AQMSConnString"
       connectionString="Host=prod-db-host;Port=5432;Database=iaq_db_prod;Username=svc_iqa_app;Password=Doh@pp@12345!"
       providerName="Npgsql" />
</connectionStrings>
	<appSettings>
		<!-- Log path -->
		<add key="LogfilePath" value="C:\AQMSLogs\AQMSServerAvgLogs"/>
		<add key="Interval" value="60000"></add>
		<add key="maxParallelism" value="10"></add>
		<add key="parameterTableName" value="sensor_reading_data"></add>
		<add key="AverageTableName" value="sensor_data_averages"></add>
		<!-- <add key="AverageTableNameMonth" value="ParameterAveragesMonth"></add> -->
		<!-- <add key="AverageTableNameYear" value="ParameterAveragesYear"></add> -->
		<add key="ReadingTableName" value="ParameterReadings"></add>
		<!-- <add key="FlagTableName" value="DMN_Flags"></add> -->
		<!-- <add key="LogTableName" value="LogTable"></add> -->
    <add key="envConString" value="DEV_AQMSConnString"/>
	<add key="winddirection" value="WD,Wind Direction" />
	<add key="rain" value="RAIN" />
		<add key="test" value="RAIN" />
	</appSettings>
	
</configuration>